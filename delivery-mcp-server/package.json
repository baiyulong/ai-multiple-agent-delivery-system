{
  "name": "delivery-mcp-server",
  "version": "0.2.1",
  "description": "AI Delivery Task System MCP Server: task state, artifact gates and seven-role delivery workflow for OpenCode",
  "type": "module",
  "bin": {
    "delivery-mcp-server": "dist/server.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "config",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/server.ts",
    "dashboard": "tsx src/dashboard.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "example": "tsx scripts/run-example.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "nodemailer": "^9.0.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "@types/nodemailer": "^8.0.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
